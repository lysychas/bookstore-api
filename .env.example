# Copy to .env and adjust. Never commit the real .env file.

# Interface to bind to (keep on loopback unless a trusted internal IP is required)
BIND_ADDRESS=127.0.0.1

# Port to listen on
PORT=3000

# Path to the SQLite database file
DATABASE_PATH=./bookstore.db

# Bearer token for admin access. Generate a long random value, e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=replace-with-a-long-random-secret
